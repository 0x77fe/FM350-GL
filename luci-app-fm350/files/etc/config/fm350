# FM350-GL 管理器配置
# 本文件同时作为首次安装的模板（/usr/share/fm350/config.template）与运行时配置，
# 缺项与非法值的兜底见 /usr/lib/fm350/lib/config.sh。

config fm350 'global'
	option enabled '1'
	option interval '5'
	option at_port ''
	# 留空 = 自动识别模组（按串口 AT 应答定位）；也可手填 0e8d:7127 指定
	option usb_vid_pid ''
	option usb_path_hint ''
	option v4_ifname 'wwan_5g_0'
	option v6_ifname 'wwan6_5g_0'
	option v6_alias '1'
	# 由守护记录其创建/接管的接口，用于改名后安全清理旧接口；不要手动编辑。
	option managed_v4_ifname ''
	option managed_v6_ifname ''

config fm350 'watch'
	option wait_timeout '180'
	option recovery_timeout '300'
	option usb_reset_timeout '600'
	option restart_timeout '1800'
	option cooldown '300'
	option usb_reset_enabled '1'
	option frozen_enabled '1'
	option frozen_sample '30'
	option frozen_grace '120'
	option ipv6_check_enabled '1'
	option ipv6_ping_target '2400:3200::1'
	option ipv6_ping_interval '15'
	option ipv4_ping_target '202.101.224.69'
	# 载波聚合：固件未提供 CA 使能命令，此项仅控制监控查询
	option ca_check_enabled '1'
	option ca_interval '120'
	option ipv6_escalate '1'
	option reappear_timeout '300'

config fm350 'profile'
	option enable '1'
	option apn 'ctnet'
	option pdp_type 'ipv4v6'
	option define_connect '3'
	option presets_enabled '0'

config fm350 'notify'
	option events_keep '200'
